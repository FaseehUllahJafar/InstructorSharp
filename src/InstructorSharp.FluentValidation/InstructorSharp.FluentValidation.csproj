<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0;netstandard2.0</TargetFrameworks>
    <PackageId>InstructorSharp.FluentValidation</PackageId>
    <Title>InstructorSharp.FluentValidation</Title>
    <Description>FluentValidation adapter for InstructorSharp. Use your existing AbstractValidator rules to validate LLM output, with failures fed back to the model as corrective feedback addressed by JSON path.</Description>
    <PackageTags>llm;structured-output;fluentvalidation;validation;instructor;ai</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="11.12.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InstructorSharp\InstructorSharp.csproj" />
  </ItemGroup>

</Project>

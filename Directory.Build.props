<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Package identity. Shared by every shippable project. -->
  <PropertyGroup>
    <Authors>Faseeh Ullah Jafar</Authors>
    <Company>Faseeh Ullah Jafar</Company>
    <Product>InstructorSharp</Product>
    <Copyright>Copyright (c) 2026 Faseeh Ullah Jafar</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/FaseehUllahJafar/InstructorSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/FaseehUllahJafar/InstructorSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>llm;openai;anthropic;structured-output;json-schema;ai;instructor;extraction;validation</PackageTags>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <!-- Reproducible, debuggable packages. -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    netstandard2.0 lets this run on .NET Framework 4.6.2+ / 4.8, which is where a
    very large amount of enterprise .NET still lives. It costs a few polyfills.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <DefineConstants>$(DefineConstants);NETSTANDARD_POLYFILL</DefineConstants>
  </PropertyGroup>

</Project>
